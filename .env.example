# ToolsYourWay — Environment Variables
# Copy this to .env and fill in the values

# Canonical public origin of the app (no trailing slash).
# Used to build OAuth callback URLs and payment success/cancel URLs.
# In production this MUST be set to your real domain — otherwise the
# server falls back to http://localhost:5000 and OAuth / payment
# redirects will break in live traffic.
#   Production:   https://www.toolsyourway.com
#   Local dev:    http://localhost:5000 (or leave unset)
BASE_URL=

# Session secret (change this to a random string in production)
SESSION_SECRET=toolsyourway-change-this-to-random-secret

# Set to "true" when deployed behind HTTPS (Render, Railway, etc.)
# Leave empty for local development (localhost uses HTTP)
SECURE_COOKIES=

# Google OAuth (optional — enables "Continue with Google" button)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Outlook OAuth (optional — enables "Continue with Outlook" button)
# Register at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://toolsyourway.com/api/auth/microsoft/callback

# Real bot integrations
# Anthropic Claude API — used by Marketing Bot for AI content generation and Virtual AI Manager
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Resend — used by Email Bot for real email sending
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# OpenAI — used for AI image generation (DALL-E 3), video storyboards, and text-to-speech (TTS)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Replicate — for AI video generation (MiniMax Hailuo, Kling)
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Stripe — for international card payments
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay — for Indian payments (UPI, cards, net banking)
# Get your keys at https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is the publishable key — it is returned to the browser
# so Razorpay Checkout can open. If it is missing, the frontend will refuse
# to open Checkout (instead of loading checkout-static-next/build/undefined).
# RAZORPAY_KEY_SECRET stays server-side and is used for HMAC verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PayPal — global payments
# Get your keys at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true

# Tap Payments — Middle East (UAE, Saudi, Bahrain, Kuwait)
# Get your key at https://tap.company/en-us/developers
TAP_SECRET_KEY=

# Xendit — Southeast Asia (Singapore, Indonesia, Philippines, Malaysia, Thailand)
# Get your key at https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=

# LinkedIn app — powers LinkedIn profile (and optionally Page) publishing.
# Create an app at https://www.linkedin.com/developers/apps, add the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# products, and whitelist the OAuth redirect URI:
#   LinkedIn (prod):  https://www.toolsyourway.com/api/social/linkedin/callback
#   LinkedIn (local): http://localhost:5000/api/social/linkedin/callback
#
# Personal profile posting only needs the default scopes
# (openid profile w_member_social email).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
#
# LinkedIn Page (Organization) destinations are OPTIONAL and require extra
# setup: your LinkedIn app must be approved for the "Community Management API"
# (organization admin) products. Once approved, opt in so the connect flow also
# requests the organization scope and can discover Pages the member administers:
#   LINKEDIN_ORG_SCOPE=1   → requests "r_organization_admin rw_organization_admin"
#   LINKEDIN_ORG_SCOPE="<exact scope string>"  → request exactly these scopes
# Leave blank if your app is not approved for organization access — personal
# profile posting still works, and the UI shows actionable helper text.
LINKEDIN_ORG_SCOPE=

# Meta / Facebook app — powers BOTH Facebook AND Instagram publishing via the
# Graph API. Create an app at https://developers.facebook.com/apps, add the
# "Facebook Login" and "Instagram Graph API" products, and register the OAuth
# redirect URIs below. Instagram publishing requires an Instagram BUSINESS or
# CREATOR account that is linked to a Facebook Page.
#
# OAuth redirect URIs to whitelist (Facebook Login → Settings → Valid OAuth
# Redirect URIs):
#   Instagram (prod):  https://www.toolsyourway.com/api/social/instagram/oauth/callback
#   Instagram (local): http://localhost:5000/api/social/instagram/oauth/callback
#   Facebook  (prod):  https://www.toolsyourway.com/api/social/facebook/callback
#   Facebook  (local): http://localhost:5000/api/social/facebook/callback
#
# Required permissions (App Review): instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement, business_management
# (FACEBOOK_* are the canonical names; META_APP_ID / META_APP_SECRET are
# accepted as aliases.)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twitter / X OAuth 1.0a — required for media upload (image / GIF / video).
# The v1.1 media/upload endpoints cannot be signed with the OAuth 2.0 PKCE
# bearer token, so a separate user-context OAuth 1.0a connection is needed.
# Set these to the "API Key" / "API Key Secret" from the X Developer Portal
# (Keys and Tokens tab). If not set, the server falls back to
# TWITTER_CLIENT_ID / TWITTER_CLIENT_SECRET — that works for many X apps
# where the same credentials are valid for both flows, but the explicit
# aliases below are preferred.
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ============================================================
# MARKETING SCHEDULED PUBLISH WORKER
# ============================================================
# Background worker that auto-publishes APPROVED + due scheduled posts to the
# per-post destinations selected at creation time.
#
# !! SAFETY: publishing to social platforms is IRREVERSIBLE. !!
# This worker is OFF by default. It only runs when explicitly enabled, and it
# only ever publishes posts in status `approved` whose scheduled time is due —
# never drafts or unapproved posts. Leave it OFF until you have tested approval
# gating and confirmed your social credentials work.
#
# Enable ONLY after testing. See docs/marketing-publish-worker.md.
ENABLE_MARKETING_PUBLISH_WORKER=false
# Poll interval in milliseconds (default 60000 = 60s). Minimum enforced: 10000.
MARKETING_PUBLISH_WORKER_INTERVAL_MS=60000
