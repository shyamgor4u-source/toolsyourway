# ToolsYourWay — Environment Variables
# Copy this to .env and fill in the values

# Session secret (change this to a random string in production)
SESSION_SECRET=toolsyourway-change-this-to-random-secret

# Set to "true" when deployed behind HTTPS (Render, Railway, etc.)
# Leave empty for local development (localhost uses HTTP)
SECURE_COOKIES=

# Google OAuth (optional — enables "Continue with Google" button)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Outlook OAuth (optional — enables "Continue with Outlook" button)
# Register at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://toolsyourway.com/api/auth/microsoft/callback

# Real bot integrations
# Anthropic Claude API — used by Marketing Bot for AI content generation and Virtual AI Manager
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Resend — used by Email Bot for real email sending
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# OpenAI — used for AI image generation (DALL-E 3) and video storyboards
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
