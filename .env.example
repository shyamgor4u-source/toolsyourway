# ToolsYourWay — Environment Variables
# Copy this to .env and fill in the values

# Canonical public origin of the app (no trailing slash).
# Used to build OAuth callback URLs and payment success/cancel URLs.
# In production this MUST be set to your real domain — otherwise the
# server falls back to http://localhost:5000 and OAuth / payment
# redirects will break in live traffic.
#   Production:   https://www.toolsyourway.com
#   Local dev:    http://localhost:5000 (or leave unset)
BASE_URL=

# Session secret (change this to a random string in production)
SESSION_SECRET=toolsyourway-change-this-to-random-secret

# Set to "true" when deployed behind HTTPS (Render, Railway, etc.)
# Leave empty for local development (localhost uses HTTP)
SECURE_COOKIES=

# Google OAuth (optional — enables "Continue with Google" button)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Outlook OAuth (optional — enables "Continue with Outlook" button)
# Register at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://toolsyourway.com/api/auth/microsoft/callback

# Real bot integrations
# Anthropic Claude API — used by Marketing Bot for AI content generation and Virtual AI Manager
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Resend — used by Email Bot for real email sending
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# OpenAI — used for AI image generation (DALL-E 3), video storyboards, and text-to-speech (TTS)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Replicate — for AI video generation (MiniMax Hailuo, Kling)
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Stripe — for international card payments
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay — for Indian payments (UPI, cards, net banking)
# Get your keys at https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is the publishable key — it is returned to the browser
# so Razorpay Checkout can open. If it is missing, the frontend will refuse
# to open Checkout (instead of loading checkout-static-next/build/undefined).
# RAZORPAY_KEY_SECRET stays server-side and is used for HMAC verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PayPal — global payments
# Get your keys at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true

# Tap Payments — Middle East (UAE, Saudi, Bahrain, Kuwait)
# Get your key at https://tap.company/en-us/developers
TAP_SECRET_KEY=

# Xendit — Southeast Asia (Singapore, Indonesia, Philippines, Malaysia, Thailand)
# Get your key at https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=
